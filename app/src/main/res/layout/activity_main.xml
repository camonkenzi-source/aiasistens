<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnFloating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AKTIFKAN IKON MELAYANG" />

    <EditText
        android:id="@+id/inputPertanyaan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tanya apa aja di sini..."
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnTanya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TANYA AI"
        android:layout_marginTop="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp">
        <TextView
            android:id="@+id/txtJawaban"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jawaban akan muncul di sini"
            android:textSize="16sp" />
    </ScrollView>
</LinearLayout>
